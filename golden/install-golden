#!/usr/bin/env python3
# install-golden: install the golden development gate into a project.
# Thin public name over golden/adopt.py's install mode. Writes only missing,
# reviewable files and a GOLDEN.md with your remaining steps.
import os
import runpy
import sys

sys.argv = [sys.argv[0], "install"] + sys.argv[1:]
runpy.run_path(os.path.join(os.path.dirname(os.path.abspath(__file__)), "adopt.py"),
               run_name="__main__")
