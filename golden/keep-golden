#!/usr/bin/env python3
# keep-golden: read-only "are we still golden?" report for a project.
# Thin public name over golden/adopt.py's audit mode. Run it any time;
# it changes nothing.
import os
import runpy
import sys

sys.argv = [sys.argv[0], "audit"] + sys.argv[1:]
runpy.run_path(os.path.join(os.path.dirname(os.path.abspath(__file__)), "adopt.py"),
               run_name="__main__")
