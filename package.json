{
  "name": "full-stack-methodology-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "test:domain": "bun test test/domain.test.mjs",
    "test:persistence": "bun test test/persistence.test.mjs",
    "test:api": "bun test test/api.test.mjs",
    "test:deterministic": "bun test test/*.test.mjs",
    "test:browser": "bun x --bun playwright test e2e/journeys.spec.ts",
    "test:candidate": "bun run test:deterministic && bun run test:browser",
    "test:reviews": "bun scripts/run-reviews.mjs",
    "start": "bun src/start.mjs",
    "test:bugsink": "bun scripts/bugsink-gate.mjs",
    "test:policy": "bun test test/policy.test.mjs",
    "test:stack": "bun run test:candidate && bun run test:bugsink && bun scripts/audit-block.mjs",
    "test:closure": "bun scripts/closure-gate.mjs",
    "test:scan": "python3 test/scan_test.py"
  },
  "devDependencies": {
    "@midscene/web": "1.17.4",
    "@playwright/test": "1.63.0",
    "dotenv": "18.0.9"
  },
  "overrides": {
    "@midscene/playground": "file:stubs/midscene-playground",
    "puppeteer-core": "file:stubs/puppeteer-core",
    "js-yaml": "4.3.2",
    "sharp": "0.35.5",
    "uuid": "11.1.1",
    "zod": "4.6.6"
  }
}
