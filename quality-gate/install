#!/usr/bin/env python3
# install: install the quality gate into a project.
# Thin public name over quality-gate/adopt.py's install mode. Writes only
# missing, reviewable files and a GATE.md with your remaining steps.
import os
import runpy
import sys

sys.argv = [sys.argv[0], "install"] + sys.argv[1:]
runpy.run_path(os.path.join(os.path.dirname(os.path.abspath(__file__)), "adopt.py"),
               run_name="__main__")
